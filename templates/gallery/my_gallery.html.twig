{% extends 'base.html.twig' %}

{% block title %}{{ 'gallery.my_gallery_title'|trans }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ 'gallery.my_gallery'|trans }}</h1>
                <a href="{{ path('app_photo_upload') }}" class="btn btn-primary">
                    <i class="fas fa-upload"></i> {{ 'gallery.upload_photo'|trans }}
                </a>
            </div>

            {% if photos|length > 0 %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                    {% for photo in photos %}
                        <div class="col">
                            <div class="card h-100 photo-card">
                                <a href="{{ path('app_photo_show', {'id': photo.id}) }}" class="text-decoration-none">
                                    {% if photo.imageName %}
                                        <img src="{{ vich_uploader_asset(photo, 'imageFile') }}" 
                                             class="card-img-top photo-thumbnail" 
                                             alt="{{ photo.title }}"
                                             loading="lazy">
                                    {% endif %}
                                    <div class="card-body">
                                        <h5 class="card-title text-dark">{{ photo.title }}</h5>
                                        <p class="card-text text-muted small">
                                            <i class="fas fa-calendar"></i> {{ photo.createdAt|date('d/m/Y') }}
                                            <br>
                                            <i class="fas fa-heart text-danger"></i> {{ photo.likesCount }} {{ 'gallery.likes'|trans }}
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="tags">
                                                {% for tag in photo.tags|slice(0, 2) %}
                                                    <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                                                {% endfor %}
                                                {% if photo.tags|length > 2 %}
                                                    <span class="badge bg-secondary">+{{ photo.tags|length - 2 }}</span>
                                                {% endif %}
                                            </div>
                                            <div class="photo-actions">
                                                <form method="post" action="{{ path('app_photo_delete', {'id': photo.id}) }}" 
                                                      class="d-inline" 
                                                      onsubmit="return confirm('{{ 'gallery.delete_confirm'|trans }}');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ photo.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-images fa-3x text-muted mb-3"></i>
                    <h3 class="text-muted">{{ 'gallery.no_photos_my'|trans }}</h3>
                    <p class="text-muted">{{ 'gallery.upload_first_my'|trans }}</p>
                    <a href="{{ path('app_photo_upload') }}" class="btn btn-primary">
                        {{ 'gallery.upload_first'|trans }}
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.photo-thumbnail {
    height: 200px;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.photo-card:hover .photo-thumbnail {
    transform: scale(1.05);
}

.photo-card {
    transition: box-shadow 0.3s ease;
}

.photo-card:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.tags .badge {
    font-size: 0.7rem;
}
</style>
{% endblock %}
